{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenbo-k.local/contracts/hermes-zenbo/device-channel.schema.json",
  "title": "Hermes Zenbo plugin device channel 1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId"
      ],
      "properties": {
        "type": {
          "const": "device.bind"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "deviceId",
        "sessionId"
      ],
      "properties": {
        "type": {
          "const": "device.bound"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "runId",
        "turnId"
      ],
      "properties": {
        "type": {
          "const": "run.activate"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "runId",
        "turnId"
      ],
      "properties": {
        "type": {
          "const": "run.active"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "runId",
        "turnId"
      ],
      "properties": {
        "type": {
          "const": "run.inactive"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "runId",
        "turnId",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "run.deactivate"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "callId",
        "sessionId",
        "runId",
        "turnId",
        "toolName",
        "toolVersion",
        "arguments",
        "timeoutMs",
        "deadlineAt"
      ],
      "properties": {
        "type": {
          "const": "tool.call"
        },
        "callId": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "toolName": {
          "enum": [
            "get_system_status",
            "start_robot_following",
            "stop_robot_following",
            "look_at_user",
            "show_emotion",
            "go_to_sleep",
            "move_robot",
            "capture_camera"
          ]
        },
        "toolVersion": {
          "const": "1.0.0"
        },
        "arguments": {
          "type": "object"
        },
        "timeoutMs": {
          "type": "integer",
          "enum": [
            5000,
            6500,
            7500
          ]
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "get_system_status"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "start_robot_following"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enablePreview": {
                    "type": "boolean"
                  },
                  "largePreview": {
                    "type": "boolean"
                  }
                },
                "required": []
              },
              "timeoutMs": {
                "const": 7500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "stop_robot_following"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "look_at_user"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "doa": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": [
                  "doa"
                ]
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "show_emotion"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "emotion": {
                    "type": "string",
                    "enum": [
                      "NEUTRAL",
                      "HAPPY",
                      "CURIOUS",
                      "CONCERNED",
                      "EXCITED"
                    ]
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30000
                  }
                },
                "required": [
                  "emotion"
                ]
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "go_to_sleep"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "move_robot"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "type": "string",
                    "enum": [
                      "forward",
                      "backward",
                      "left",
                      "right"
                    ]
                  }
                },
                "required": [
                  "direction"
                ]
              },
              "timeoutMs": {
                "const": 6500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toolName": {
                "const": "capture_camera"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "timeoutMs": {
                "const": 5000
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "callId",
        "sessionId",
        "runId",
        "turnId",
        "status",
        "updatedAt"
      ],
      "properties": {
        "type": {
          "const": "tool.result"
        },
        "callId": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "accepted",
            "succeeded",
            "failed",
            "rejected"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "output": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "output"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "callId",
        "status"
      ],
      "properties": {
        "type": {
          "const": "tool.ack"
        },
        "callId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "accepted",
            "succeeded",
            "failed",
            "rejected"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  ]
}
