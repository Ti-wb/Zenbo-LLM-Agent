{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenbo-k.local/contracts/hermes-zenbo/speech.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "mimeType",
          "byteLength",
          "sha256",
          "expiresAt"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "mimeType": {
            "enum": [
              "audio/mpeg",
              "audio/wav"
            ]
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
