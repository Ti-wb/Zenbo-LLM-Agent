{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenbo-k.local/contracts/agent-gateway/tool-manifest.schema.json",
  "title": "Zenbo device tool manifest",
  "description": "Device-owned tools that the Agent Gateway may request over the session event stream.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "manifestVersion", "tools"],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "manifestVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "objectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "version",
        "description",
        "inputSchema",
        "resultSchema",
        "sideEffect",
        "idempotent",
        "requiresConfirmation",
        "timeoutMs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "get_system_status",
            "start_robot_following",
            "stop_robot_following",
            "look_at_user",
            "show_emotion",
            "go_to_sleep"
          ]
        },
        "owner": {
          "enum": ["native", "web"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "inputSchema": {
          "$ref": "#/$defs/objectSchema"
        },
        "resultSchema": {
          "$ref": "#/$defs/objectSchema"
        },
        "sideEffect": {
          "enum": ["none", "ui", "physical"]
        },
        "idempotent": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 15000
        }
      }
    }
  }
}
