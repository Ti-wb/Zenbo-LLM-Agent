{
  "openapi": "3.1.0",
  "info": {
    "title": "Zenbo Native Local Runtime 2.0",
    "version": "2.0.0",
    "description": "Native-owned loopback API for the bundled renderer. Hermes runs, credentials and remote IDs remain Native concerns."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787/api/v2",
      "description": "Fixed IPv4 loopback endpoint",
      "x-loopback-only": true
    }
  ],
  "security": [
    {
      "LocalSessionCookie": []
    }
  ],
  "paths": {
    "/bootstrap": {
      "post": {
        "operationId": "bootstrapRenderer",
        "summary": "Create an authenticated renderer session cookie",
        "description": "Consumes a native-generated one-time 256-bit bootstrap token after constant-time verification. The token expires after 60 seconds and is consumed on success or failure.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renderer session created",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "Host-only cookie: zenbo_local_session=<opaque>; Path=/api/v2; HttpOnly; SameSite=Strict; Max-Age=<bounded>. Domain is forbidden.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getRuntimeStatus",
        "summary": "Read local runtime, gateway, robot, and active-turn status",
        "responses": {
          "200": {
            "description": "Current runtime status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/motion": {
      "put": {
        "operationId": "setMotionPermission",
        "summary": "Set the persisted device motion permission",
        "description": "Requires the renderer session cookie and exact Origin, but no settings PIN or unlock lease. The request accepts only enabled. Motion permission defaults to false. When disabled, start_robot_following and look_at_user are rejected with tool error MOTION_DISABLED; stop_robot_following remains available. A rejected motion tool does not fail the conversation turn. Disabling immediately blocks new and queued motion and stops only app-owned active or pending motion; disabling while idle does not call the robot SDK. Enabling grants permission only after persistence succeeds. Storage failures return HTTP 500 INTERNAL_ERROR. If disabling cannot be persisted, runtime permission remains off; the renderer refreshes status after the error instead of restoring permission.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MotionUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current persisted motion permission and movement state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MotionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Read redacted runtime settings and lock state",
        "responses": {
          "200": {
            "description": "Redacted settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "put": {
        "operationId": "updateSettings",
        "summary": "Update unlocked runtime settings and optional write-only Hermes API key",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated redacted settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "423": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/settings/setup": {
      "post": {
        "operationId": "setupRuntimeSettings",
        "summary": "Atomically configure the initial PIN, Gateway, token, trust, profile, and context",
        "description": "Available only while setupRequired is true. Validation and persistence are atomic: a failure stores neither the PIN nor any Gateway setting.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsSetupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Initial configuration stored and returned with secrets redacted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/settings/unlock": {
      "post": {
        "operationId": "unlockSettings",
        "summary": "Verify the admin PIN and create a time-bounded unlock lease",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUnlockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings unlocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnlockResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/settings/test": {
      "post": {
        "operationId": "testSettings",
        "summary": "Probe gateway URL, TLS, credential, and protocol without persisting changes",
        "description": "Allowed while initial setup is required, or after setup only while the renderer has a current settings unlock lease.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Probe completed; reachability is represented in data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsTestResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "423": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "502": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation": {
      "get": {
        "operationId": "getConversation",
        "summary": "Read the authoritative local conversation/session snapshot",
        "responses": {
          "200": {
            "description": "Current conversation state and retained canonical events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation/turns": {
      "post": {
        "operationId": "createConversationTurn",
        "summary": "Submit one text turn or completed WAV voice turn",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextTurnRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/VoiceTurnRequest"
              },
              "encoding": {
                "audio": {
                  "contentType": "audio/wav"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Turn accepted for asynchronous processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "413": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "415": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation/cancel": {
      "post": {
        "operationId": "cancelConversationTurn",
        "summary": "Cancel the turn identified in the JSON request body",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelTurnRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cancellation accepted or the turn was already terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation/tool-calls/{callId}": {
      "put": {
        "operationId": "putWebToolCallResult",
        "summary": "Report an accepted or terminal result for a correlated Web-owned tool call",
        "description": "Native validates web ownership, deadline and correlation before submitting the result to the Hermes Zenbo plugin. Repeating an identical local terminal receipt is idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CallId"
          },
          {
            "$ref": "#/components/parameters/RendererOrigin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolCallUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correlated tool-call update accepted by Native",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCallReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "413": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation/playback": {
      "post": {
        "operationId": "reportRendererPlayback",
        "summary": "Report renderer audio playback lifecycle for one turn artifact",
        "description": "Native records playback locally. Only the final ordered artifact completion ends the turn; no remote playback endpoint exists.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackUpdate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Playback update accepted locally",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/conversation/audio/{artifactId}": {
      "get": {
        "operationId": "getConversationAudio",
        "summary": "Download one locally cached verified Hermes audio artifact",
        "parameters": [
          {
            "$ref": "#/components/parameters/ArtifactId"
          }
        ],
        "responses": {
          "200": {
            "description": "Raw audio bytes; the only non-envelope successful HTTP response",
            "headers": {
              "Digest": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              },
              "Expires": {
                "required": true,
                "description": "HTTP-date after which the local artifact is unavailable.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              },
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "410": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "connectLocalEvents",
        "summary": "Upgrade to the native-to-renderer canonical event relay",
        "x-websocket": true,
        "x-message-schema": "./schemas/event.schema.json",
        "parameters": [
          {
            "$ref": "#/components/parameters/RendererOrigin"
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Last canonical sequence durably handled by the renderer."
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "zenbo_local_session",
        "description": "Opaque host-only HttpOnly SameSite=Strict renderer-session cookie issued only by POST /bootstrap."
      }
    },
    "parameters": {
      "RendererOrigin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "const": "http://127.0.0.1:8787"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ArtifactId": {
        "name": "artifactId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CallId": {
        "name": "callId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Uniform Local Runtime error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Local operation rate limited",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "requestId",
          "data",
          "error"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {},
          "error": {
            "type": "null"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "requestId",
          "data",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/LocalError"
          }
        }
      },
      "LocalErrorCode": {
        "enum": [
          "INVALID_REQUEST",
          "UNAUTHORIZED",
          "FORBIDDEN_ORIGIN",
          "RATE_LIMITED",
          "NOT_FOUND",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "GATEWAY_UNCONFIGURED",
          "GATEWAY_AUTH",
          "GATEWAY_TLS",
          "GATEWAY_INCOMPATIBLE",
          "GATEWAY_OFFLINE",
          "SESSION_EXPIRED",
          "TURN_CANCELLED",
          "ROBOT_INITIALIZING",
          "ROBOT_UNAVAILABLE",
          "TOOL_REJECTED",
          "TIMEOUT",
          "ARTIFACT_EXPIRED",
          "INTERNAL_ERROR",
          "INVALID_BOOTSTRAP_TOKEN",
          "SETUP_REQUIRED",
          "ALREADY_CONFIGURED",
          "SETTINGS_LOCKED",
          "INVALID_PIN",
          "INVALID_SETTINGS",
          "TURN_BUSY"
        ]
      },
      "LocalError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/LocalErrorCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "BootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientVersion",
          "bootstrapToken"
        ],
        "properties": {
          "clientVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "bootstrapToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "writeOnly": true
          }
        }
      },
      "BootstrapData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "expiresAt"
        ],
        "properties": {
          "protocolVersion": {
            "const": "2.0"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GatewayState": {
        "enum": [
          "UNCONFIGURED",
          "CONNECTING",
          "READY",
          "DEGRADED",
          "AUTH_ERROR",
          "TLS_ERROR",
          "INCOMPATIBLE",
          "OFFLINE"
        ]
      },
      "TurnState": {
        "enum": [
          "IDLE",
          "LISTENING",
          "UPLOADING",
          "TRANSCRIBING",
          "THINKING",
          "AWAITING_TOOL",
          "SYNTHESIZING",
          "SPEAKING",
          "ERROR"
        ]
      },
      "TrustMode": {
        "enum": [
          "SYSTEM_TRUST",
          "CONFIRMED_SPKI_PIN"
        ]
      },
      "SpkiFingerprint": {
        "type": "string",
        "pattern": "^sha256/[A-Za-z0-9+/]{43}=$"
      },
      "StatusData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtimeReady",
          "setupRequired",
          "settingsUnlocked",
          "gatewayState",
          "robotReady",
          "activeSessionId",
          "activeTurnId",
          "lastSequence",
          "protocolVersion",
          "motionEnabled"
        ],
        "properties": {
          "runtimeReady": {
            "type": "boolean"
          },
          "setupRequired": {
            "type": "boolean"
          },
          "settingsUnlocked": {
            "type": "boolean"
          },
          "gatewayState": {
            "$ref": "#/components/schemas/GatewayState"
          },
          "robotReady": {
            "type": "boolean"
          },
          "activeSessionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "activeTurnId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "lastSequence": {
            "type": "integer",
            "minimum": 0
          },
          "protocolVersion": {
            "const": "2.0"
          },
          "motionEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Persisted Native permission for following and looking toward the user. Defaults to false."
          }
        }
      },
      "RuntimeContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "robotName",
          "language"
        ],
        "properties": {
          "robotName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          }
        }
      },
      "SettingsData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gatewayUrl",
          "trustMode",
          "context",
          "hasApiKey",
          "certificatePinConfigured",
          "pinConfigured",
          "unlocked",
          "unlockExpiresAt"
        ],
        "properties": {
          "gatewayUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "trustMode": {
            "$ref": "#/components/schemas/TrustMode"
          },
          "context": {
            "$ref": "#/components/schemas/RuntimeContext"
          },
          "hasApiKey": {
            "type": "boolean"
          },
          "certificatePinConfigured": {
            "type": "boolean"
          },
          "pinConfigured": {
            "type": "boolean"
          },
          "unlocked": {
            "type": "boolean"
          },
          "unlockExpiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "SettingsSetupRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Initial setup is one transaction. pin must equal confirmPin. For CONFIRMED_SPKI_PIN, certificatePin and confirmedFingerprint are required and must be identical.",
        "required": [
          "pin",
          "confirmPin",
          "gatewayUrl",
          "apiKey",
          "trustMode",
          "context"
        ],
        "dependentRequired": {
          "certificatePin": [
            "confirmedFingerprint"
          ],
          "confirmedFingerprint": [
            "certificatePin"
          ]
        },
        "properties": {
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6,12}$",
            "writeOnly": true
          },
          "confirmPin": {
            "type": "string",
            "pattern": "^[0-9]{6,12}$",
            "writeOnly": true
          },
          "gatewayUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048,
            "default": "https://hermes.example.com/hermes-api/p/robot/v1"
          },
          "apiKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096,
            "writeOnly": true
          },
          "trustMode": {
            "$ref": "#/components/schemas/TrustMode"
          },
          "certificatePin": {
            "$ref": "#/components/schemas/SpkiFingerprint"
          },
          "confirmedFingerprint": {
            "$ref": "#/components/schemas/SpkiFingerprint"
          },
          "context": {
            "$ref": "#/components/schemas/RuntimeContext"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "trustMode": {
                  "const": "CONFIRMED_SPKI_PIN"
                }
              },
              "required": [
                "trustMode"
              ]
            },
            "then": {
              "required": [
                "certificatePin",
                "confirmedFingerprint"
              ]
            }
          }
        ]
      },
      "SettingsUnlockRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pin"
        ],
        "properties": {
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6,12}$",
            "writeOnly": true
          }
        }
      },
      "SettingsUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trustMode"
        ],
        "description": "apiKey is write-only. For CONFIRMED_SPKI_PIN, certificatePin and confirmedFingerprint are required and must be identical.",
        "dependentRequired": {
          "certificatePin": [
            "confirmedFingerprint"
          ],
          "confirmedFingerprint": [
            "certificatePin"
          ]
        },
        "properties": {
          "gatewayUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048,
            "default": "https://hermes.example.com/hermes-api/p/robot/v1"
          },
          "apiKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096,
            "writeOnly": true
          },
          "trustMode": {
            "$ref": "#/components/schemas/TrustMode"
          },
          "certificatePin": {
            "$ref": "#/components/schemas/SpkiFingerprint"
          },
          "confirmedFingerprint": {
            "$ref": "#/components/schemas/SpkiFingerprint"
          },
          "context": {
            "$ref": "#/components/schemas/RuntimeContext"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "trustMode": {
                  "const": "CONFIRMED_SPKI_PIN"
                }
              },
              "required": [
                "trustMode"
              ]
            },
            "then": {
              "required": [
                "certificatePin",
                "confirmedFingerprint"
              ]
            }
          }
        ]
      },
      "SettingsTestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gatewayUrl",
          "trustMode"
        ],
        "description": "SYSTEM_TRUST may use apiKey transiently for authenticated capability discovery. CONFIRMED_SPKI_PIN without a previously confirmed fingerprint performs a certificate-only probe and never transmits apiKey.",
        "properties": {
          "gatewayUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048,
            "default": "https://hermes.example.com/hermes-api/p/robot/v1"
          },
          "trustMode": {
            "$ref": "#/components/schemas/TrustMode"
          },
          "apiKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096,
            "writeOnly": true
          }
        }
      },
      "UnlockData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unlocked",
          "unlockExpiresAt"
        ],
        "properties": {
          "unlocked": {
            "const": true
          },
          "unlockExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SettingsTestData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reachable",
          "tlsTrusted",
          "latencyMs",
          "protocolVersion",
          "confirmationRequired",
          "fingerprint",
          "authenticated",
          "capabilitiesReceived"
        ],
        "properties": {
          "reachable": {
            "type": "boolean"
          },
          "tlsTrusted": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "protocolVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmationRequired": {
            "type": "boolean"
          },
          "fingerprint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpkiFingerprint"
              },
              {
                "type": "null"
              }
            ]
          },
          "authenticated": {
            "type": "boolean"
          },
          "capabilitiesReceived": {
            "type": "boolean"
          }
        }
      },
      "ConversationData": {
        "type": "object",
        "additionalProperties": false,
        "description": "Authoritative renderer recovery snapshot for the current Native-owned session and active turn.",
        "required": [
          "sessionId",
          "activeTurnId",
          "turnState",
          "lastSequence",
          "transcript",
          "assistantText"
        ],
        "properties": {
          "sessionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "activeTurnId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "turnState": {
            "$ref": "#/components/schemas/TurnState"
          },
          "lastSequence": {
            "type": "integer",
            "minimum": 0
          },
          "transcript": {
            "type": "string",
            "maxLength": 16000
          },
          "assistantText": {
            "type": "string",
            "maxLength": 64000
          }
        }
      },
      "TextTurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientTurnId",
          "text"
        ],
        "properties": {
          "clientTurnId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          }
        }
      },
      "VoiceTurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientTurnId",
          "audio",
          "durationMs"
        ],
        "properties": {
          "clientTurnId": {
            "type": "string",
            "format": "uuid"
          },
          "audio": {
            "type": "string",
            "contentEncoding": "binary",
            "contentMediaType": "audio/wav",
            "x-max-bytes": 2097152
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          }
        }
      },
      "TurnAcceptedData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientTurnId",
          "accepted"
        ],
        "properties": {
          "clientTurnId": {
            "type": "string",
            "format": "uuid"
          },
          "accepted": {
            "const": true
          }
        }
      },
      "CancelTurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "enum": [
              "barge_in",
              "user_interaction",
              "screen_off",
              "sleep"
            ]
          }
        }
      },
      "CancelResultData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "remoteCancelled",
          "robotStopped"
        ],
        "properties": {
          "remoteCancelled": {
            "type": "boolean"
          },
          "robotStopped": {
            "type": "boolean"
          }
        }
      },
      "ToolCallReceiptData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callId",
          "status"
        ],
        "properties": {
          "callId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "rejected"
            ]
          }
        }
      },
      "PlaybackReceiptData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turnId",
          "artifactId",
          "status"
        ],
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "interrupted"
            ]
          }
        }
      },
      "BootstrapResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/BootstrapData"
              }
            }
          }
        ]
      },
      "StatusResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/StatusData"
              }
            }
          }
        ]
      },
      "SettingsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/SettingsData"
              }
            }
          }
        ]
      },
      "UnlockResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/UnlockData"
              }
            }
          }
        ]
      },
      "SettingsTestResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/SettingsTestData"
              }
            }
          }
        ]
      },
      "ConversationResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ConversationData"
              }
            }
          }
        ]
      },
      "TurnAcceptedResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/TurnAcceptedData"
              }
            }
          }
        ]
      },
      "CancelResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/CancelResultData"
              }
            }
          }
        ]
      },
      "ToolCallReceiptResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ToolCallReceiptData"
              }
            }
          }
        ]
      },
      "PlaybackReceiptResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/PlaybackReceiptData"
              }
            }
          }
        ]
      },
      "ToolCallUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "updatedAt"
        ],
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "rejected"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "output": {
            "description": "JSON-compatible tool output; serialized UTF-8 representation is limited to 16 KiB.",
            "x-max-bytes": 16384
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "description": "A succeeded update carries output. Failed or rejected updates carry error. Timeout and turn cancellation use failed with error code TIMEOUT or TURN_CANCELLED. Terminal states cannot transition."
      },
      "PlaybackUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turnId",
          "artifactId",
          "status",
          "timestamp"
        ],
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "interrupted"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "positionMs": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "enum": [
              "barge_in",
              "screen_off",
              "playback_error",
              "client_cancelled"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "started",
                  "completed"
                ]
              }
            }
          },
          {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "interrupted"
              }
            }
          }
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "MotionUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "MotionStateData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "motionEnabled",
          "moving"
        ],
        "properties": {
          "motionEnabled": {
            "type": "boolean"
          },
          "moving": {
            "type": "boolean"
          }
        }
      },
      "MotionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/MotionStateData"
              }
            }
          }
        ]
      }
    }
  }
}
