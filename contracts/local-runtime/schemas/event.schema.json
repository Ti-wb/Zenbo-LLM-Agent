{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenbo-k.local/contracts/local-runtime/event.schema.json",
  "title": "Zenbo Local Runtime WebSocket event",
  "description": "Either an unchanged replayable Agent Gateway envelope or an ephemeral local control envelope.",
  "oneOf": [
    {
      "$ref": "../../agent-gateway/schemas/ws-envelope.schema.json"
    },
    {
      "$ref": "#/$defs/localControlEnvelope"
    }
  ],
  "$defs": {
    "localControlEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "eventId", "type", "timestamp", "data"],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "eventId": { "type": "string", "format": "uuid" },
        "type": {
          "enum": [
            "local.gateway.state",
            "local.robot.state",
            "local.screen.state",
            "local.interaction"
          ]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "data": { "type": "object" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "local.gateway.state" },
            "data": { "$ref": "#/$defs/gatewayState" }
          }
        },
        {
          "properties": {
            "type": { "const": "local.robot.state" },
            "data": { "$ref": "#/$defs/robotState" }
          }
        },
        {
          "properties": {
            "type": { "const": "local.screen.state" },
            "data": { "$ref": "#/$defs/screenState" }
          }
        },
        {
          "properties": {
            "type": { "const": "local.interaction" },
            "data": { "$ref": "#/$defs/interaction" }
          }
        }
      ]
    },
    "gatewayState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "../openapi.json#/components/schemas/GatewayState" },
        "detail": { "type": "string", "maxLength": 512 },
        "errorCode": { "$ref": "../openapi.json#/components/schemas/LocalErrorCode" }
      }
    },
    "robotState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "moving"],
      "properties": {
        "ready": { "type": "boolean" },
        "moving": { "type": "boolean" }
      }
    },
    "screenState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["ON", "OFF"] }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "HEAD_PRESS" }
      }
    }
  }
}
