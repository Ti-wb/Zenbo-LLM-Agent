{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenbo-k.local/contracts/local-runtime/event.schema.json",
  "title": "Zenbo Local Runtime WebSocket event",
  "description": "Native-owned conversation or control event. Every frame advances the local sequence.",
  "oneOf": [
    {
      "$ref": "./conversation-event.schema.json"
    },
    {
      "$ref": "#/$defs/localControlEnvelope"
    }
  ],
  "$defs": {
    "localControlEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "eventId",
        "sequence",
        "type",
        "timestamp",
        "data"
      ],
      "properties": {
        "protocolVersion": {
          "const": "2.0"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "local.gateway.state",
            "local.robot.state",
            "local.screen.state",
            "local.interaction"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "local.gateway.state"
            },
            "data": {
              "$ref": "#/$defs/gatewayState"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "local.robot.state"
            },
            "data": {
              "$ref": "#/$defs/robotState"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "local.screen.state"
            },
            "data": {
              "$ref": "#/$defs/screenState"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "local.interaction"
            },
            "data": {
              "$ref": "#/$defs/interaction"
            }
          }
        }
      ]
    },
    "gatewayState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "../openapi.json#/components/schemas/GatewayState"
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        },
        "errorCode": {
          "$ref": "../openapi.json#/components/schemas/LocalErrorCode"
        }
      }
    },
    "robotState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "moving",
        "motionEnabled",
        "battery"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "moving": {
          "type": "boolean"
        },
        "motionEnabled": {
          "type": "boolean",
          "default": false
        },
        "battery": {
          "$ref": "../openapi.json#/components/schemas/BatteryState"
        }
      }
    },
    "screenState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ON",
            "OFF"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "HEAD_PRESS"
        }
      }
    }
  }
}
