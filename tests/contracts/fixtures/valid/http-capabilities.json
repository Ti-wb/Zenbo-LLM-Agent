{
  "protocolVersion": "1.0",
  "audioInput": {
    "contentTypes": ["audio/wav"],
    "maxBytes": 2097152,
    "maxDurationMs": 30000
  },
  "audioOutput": {
    "contentTypes": ["audio/mpeg"],
    "maxBytes": 10485760
  },
  "eventTypes": [
    "session.ready",
    "session.snapshot",
    "turn.accepted",
    "stt.final",
    "agent.thinking",
    "tool.call",
    "agent.text.final",
    "tts.ready",
    "turn.completed",
    "turn.error",
    "session.expired"
  ],
  "agentProfiles": [
    {
      "id": "kira-default",
      "displayName": "Kira",
      "languages": ["de-DE"],
      "isDefault": true
    }
  ],
  "retentionPolicy": {
    "rawAudio": {
      "retained": false,
      "maxAgeSeconds": 0
    },
    "transcript": {
      "retained": true,
      "maxAgeSeconds": 86400
    }
  }
}
