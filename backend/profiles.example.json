{
  "profiles": [
    {
      "id": "default",
      "displayName": "Codex OAuth",
      "languages": ["zh-TW", "en"],
      "isDefault": true,
      "kind": "codex",
      "llm": {
        "model": "gpt-5.6-terra",
        "timeout": "90s"
      },
      "media": {
        "baseUrl": "http://host.docker.internal:4000/v1",
        "apiKeyEnv": "LITELLM_API_KEY",
        "transcriptionModel": "whisper-1",
        "speechModel": "tts-1",
        "voice": "alloy",
        "timeout": "60s"
      }
    },
    {
      "id": "litellm",
      "displayName": "LiteLLM Responses",
      "languages": ["zh-TW", "en"],
      "isDefault": false,
      "kind": "openai-compatible",
      "llm": {
        "baseUrl": "http://host.docker.internal:4000/v1",
        "apiKeyEnv": "LITELLM_API_KEY",
        "mode": "responses",
        "model": "gpt-5-mini",
        "timeout": "90s"
      },
      "media": {
        "baseUrl": "http://host.docker.internal:4000/v1",
        "apiKeyEnv": "LITELLM_API_KEY",
        "transcriptionModel": "whisper-1",
        "speechModel": "tts-1",
        "voice": "alloy",
        "timeout": "60s"
      }
    },
    {
      "id": "litellm-chat",
      "displayName": "LiteLLM Chat Completions",
      "languages": ["zh-TW", "en"],
      "isDefault": false,
      "kind": "openai-compatible",
      "llm": {
        "baseUrl": "http://host.docker.internal:4000/v1",
        "apiKeyEnv": "LITELLM_API_KEY",
        "mode": "chat_completions",
        "model": "gpt-5-mini",
        "timeout": "90s"
      },
      "media": {
        "baseUrl": "http://host.docker.internal:4000/v1",
        "apiKeyEnv": "LITELLM_API_KEY",
        "transcriptionModel": "whisper-1",
        "speechModel": "tts-1",
        "voice": "alloy",
        "timeout": "60s"
      }
    }
  ]
