{
  "openapi": "3.1.0",
  "info": {
    "title": "Zenbo Agent Gateway",
    "version": "0.1.0",
    "description": "HTTP and native WebSocket contract for a Zenbo-K thin client. Provider credentials remain exclusively in the external gateway."
  },
  "servers": [
    {
      "url": "https://gateway.example.com/agent/v1",
      "description": "Deployment-specific Agent Gateway base URL"
    }
  ],
  "security": [
    {
      "DeviceBearer": []
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Read gateway protocol and media limits",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "Gateway capabilities for protocol 1.0",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Capabilities" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create one active Agent Gateway session for the device",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created or the idempotent prior result returned",
            "headers": {
              "Location": {
                "required": true,
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/sessions/{sessionId}": {
      "parameters": [
        { "$ref": "#/components/parameters/SessionId" }
      ],
      "get": {
        "operationId": "getSession",
        "summary": "Read session state and replay cursor",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      },
      "delete": {
        "operationId": "deleteSession",
        "summary": "Close a session idempotently",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" }
        ],
        "responses": {
          "204": { "description": "Session is closed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions/{sessionId}/turns": {
      "post": {
        "operationId": "createTurn",
        "summary": "Submit one completed text or voice turn",
        "description": "Accepts either JSON text or mono PCM WAV audio up to 30 seconds and 2 MiB. The gateway performs agent orchestration asynchronously.",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TextTurn" }
            },
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/TurnUpload" },
              "encoding": {
                "audio": {
                  "contentType": "audio/wav"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Turn accepted for asynchronous processing",
            "headers": {
              "Location": {
                "required": true,
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnAccepted" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/sessions/{sessionId}/turns/{turnId}/cancel": {
      "post": {
        "operationId": "cancelTurn",
        "summary": "Request cancellation of an active turn",
        "description": "Cancellation is idempotent. A terminal turn remains terminal and is returned unchanged.",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/TurnId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CancelTurnRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cancellation accepted or turn already terminal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnState" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions/{sessionId}/tool-calls/{callId}": {
      "put": {
        "operationId": "putToolCallResult",
        "summary": "Report a correlated device tool-call state or terminal result",
        "description": "Updates are monotonic. Repeating an identical representation is idempotent; attempting to replace a terminal result returns 409.",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/CallId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ToolCallUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored tool-call state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ToolCallUpdate" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions/{sessionId}/audio/{artifactId}": {
      "get": {
        "operationId": "getAudioArtifact",
        "summary": "Download one gateway-produced audio artifact",
        "description": "The response body is limited to 10 MiB and its SHA-256 digest must match the artifact metadata received over the event stream.",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/ArtifactId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "Audio bytes; at most 10 MiB",
            "headers": {
              "Digest": {
                "required": true,
                "description": "RFC 9530 SHA-256 content digest",
                "schema": { "type": "string" }
              },
              "Content-Length": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              },
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "410": { "$ref": "#/components/responses/Gone" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions/{sessionId}/playback": {
      "post": {
        "operationId": "reportPlayback",
        "summary": "Report device playback lifecycle for a requested audio artifact",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlaybackUpdate" }
            }
          }
        },
        "responses": {
          "202": { "description": "Playback update accepted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    },
    "/sessions/{sessionId}/events": {
      "get": {
        "operationId": "connectEventStream",
        "summary": "Upgrade to the outbound session WebSocket event stream",
        "description": "Native OkHttp must send the same Authorization bearer token and Zenbo headers as HTTP. The stream is gateway-to-device; reconnect with after equal to the last durably handled sequence.",
        "x-websocket": true,
        "x-message-schema": "./schemas/ws-envelope.schema.json",
        "x-stale-cursor-recovery": {
          "eventType": "session.snapshot",
          "cursorField": "data.lastSequence"
        },
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/ProtocolVersion" },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Last sequence durably handled by the device; the server replays events with a greater sequence. Omit on first connection.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "101": { "description": "WebSocket upgrade accepted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "The requested replay cursor is ahead of the session cursor",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "426": { "$ref": "#/components/responses/ProtocolMismatch" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque device-scoped token",
        "description": "One revocable token scoped to a single Zenbo device and the Agent Gateway API. It is not a provider credential."
      }
    },
    "parameters": {
      "DeviceId": {
        "name": "X-Zenbo-Device-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "ProtocolVersion": {
        "name": "X-Zenbo-Protocol",
        "in": "header",
        "required": true,
        "schema": { "const": "1.0" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-generated UUID retained for at least the session lifetime.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TurnId": {
        "name": "turnId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "CallId": {
        "name": "callId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ArtifactId": {
        "name": "artifactId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "BadRequest": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Unauthorized": {
        "description": "Missing, invalid, revoked, or device-mismatched credential",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Conflict": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Gone": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "PayloadTooLarge": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "UnsupportedMediaType": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Unprocessable": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "ProtocolMismatch": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "RateLimited": {
        "description": "Device-scoped request quota exceeded",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "ErrorResponse": {
        "description": "Agent Gateway error",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "audioInput",
          "audioOutput",
          "eventTypes",
          "agentProfiles",
          "retentionPolicy"
        ],
        "properties": {
          "protocolVersion": { "const": "1.0" },
          "audioInput": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contentTypes", "maxBytes", "maxDurationMs"],
            "properties": {
              "contentTypes": {
                "type": "array",
                "prefixItems": [{ "const": "audio/wav" }],
                "items": false,
                "minItems": 1,
                "maxItems": 1
              },
              "maxBytes": { "const": 2097152 },
              "maxDurationMs": { "const": 30000 }
            }
          },
          "audioOutput": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contentTypes", "maxBytes"],
            "properties": {
              "contentTypes": {
                "type": "array",
                "items": { "enum": ["audio/mpeg", "audio/wav"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "maxBytes": { "const": 10485760 }
            }
          },
          "eventTypes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GatewayEventType" },
            "minItems": 1,
            "uniqueItems": true
          },
          "agentProfiles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AgentProfile" },
            "minItems": 1
          },
          "retentionPolicy": {
            "$ref": "#/components/schemas/RetentionPolicy"
          }
        }
      },
      "GatewayEventType": {
        "enum": [
          "session.ready",
          "session.snapshot",
          "turn.accepted",
          "stt.final",
          "agent.thinking",
          "tool.call",
          "agent.text.final",
          "tts.ready",
          "turn.completed",
          "turn.error",
          "session.expired",
          "turn.cancelled",
          "session.closed"
        ]
      },
      "AgentProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "languages"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 2, "maxLength": 35 },
            "minItems": 1,
            "uniqueItems": true
          },
          "isDefault": { "type": "boolean" }
        }
      },
      "RetentionPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rawAudio", "transcript"],
        "properties": {
          "rawAudio": { "$ref": "#/components/schemas/RetentionRule" },
          "transcript": { "$ref": "#/components/schemas/RetentionRule" }
        }
      },
      "RetentionRule": {
        "type": "object",
        "additionalProperties": false,
        "required": ["retained", "maxAgeSeconds"],
        "properties": {
          "retained": { "type": "boolean" },
          "maxAgeSeconds": { "type": "integer", "minimum": 0 }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client", "agentProfile", "context", "toolManifest"],
        "properties": {
          "client": {
            "type": "object",
            "additionalProperties": false,
            "required": ["appVersion", "platform", "robotModel", "locale"],
            "properties": {
              "appVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
              "platform": { "const": "android" },
              "robotModel": { "const": "zenbo-k" },
              "osVersion": { "type": "string", "maxLength": 64 },
              "locale": { "type": "string", "minLength": 2, "maxLength": 35 }
            }
          },
          "agentProfile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["robotName", "language"],
            "properties": {
              "robotName": { "type": "string", "minLength": 1, "maxLength": 64 },
              "language": { "type": "string", "minLength": 2, "maxLength": 35 }
            }
          },
          "toolManifest": {
            "$ref": "./schemas/tool-manifest.schema.json"
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "deviceId",
          "protocolVersion",
          "state",
          "createdAt",
          "expiresAt",
          "lastSequence"
        ],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "deviceId": { "type": "string" },
          "protocolVersion": { "const": "1.0" },
          "state": { "enum": ["active", "closing", "closed", "expired"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "lastSequence": { "type": "integer", "minimum": 0 }
        }
      },
      "TurnUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientTurnId", "audio", "durationMs"],
        "properties": {
          "clientTurnId": { "type": "string", "format": "uuid" },
          "audio": {
            "type": "string",
            "contentEncoding": "binary",
            "contentMediaType": "audio/wav",
            "maxLength": 2097152,
            "x-max-bytes": 2097152
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "language": { "type": "string", "minLength": 2, "maxLength": 35 }
        }
      },
      "TextTurn": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientTurnId", "text"],
        "properties": {
          "clientTurnId": { "type": "string", "format": "uuid" },
          "text": { "type": "string", "minLength": 1, "maxLength": 16000 },
          "language": { "type": "string", "minLength": 2, "maxLength": 35 }
        }
      },
      "TurnAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "turnId", "clientTurnId", "state", "acceptedAt"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "turnId": { "type": "string", "format": "uuid" },
          "clientTurnId": { "type": "string", "format": "uuid" },
          "state": { "const": "accepted" },
          "acceptedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CancelTurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": { "enum": ["client_request", "superseded", "timeout"] }
        }
      },
      "TurnState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turnId", "state", "updatedAt"],
        "properties": {
          "turnId": { "type": "string", "format": "uuid" },
          "state": {
            "enum": ["accepted", "processing", "waiting_for_tool", "completed", "cancelled", "failed"]
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ToolCallUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "updatedAt"],
        "properties": {
          "status": {
            "enum": ["accepted", "succeeded", "failed", "rejected"]
          },
          "updatedAt": { "type": "string", "format": "date-time" },
          "output": {
            "description": "JSON-compatible tool output; serialized UTF-8 representation is limited to 16 KiB.",
            "x-max-bytes": 16384
          },
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        },
        "description": "A succeeded update carries output. Failed or rejected updates carry error. Timeout and turn cancellation use failed with error code TIMEOUT or TURN_CANCELLED. Terminal states cannot transition."
      },
      "PlaybackUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turnId", "artifactId", "status", "timestamp"],
        "properties": {
          "turnId": { "type": "string", "format": "uuid" },
          "artifactId": { "type": "string", "format": "uuid" },
          "status": { "enum": ["started", "completed", "interrupted"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "positionMs": { "type": "integer", "minimum": 0 },
          "reason": {
            "enum": ["barge_in", "screen_off", "playback_error", "client_cancelled"]
          }
        },
        "oneOf": [
          {
            "properties": {
              "status": { "enum": ["started", "completed"] }
            }
          },
          {
            "required": ["reason"],
            "properties": {
              "status": { "const": "interrupted" }
            }
          }
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "message": { "type": "string", "minLength": 1, "maxLength": 512 },
          "retryable": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "code", "retryable", "requestId"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string", "maxLength": 1024 },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "retryable": { "type": "boolean" },
          "requestId": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
