{
	email {$ACME_EMAIL}
	admin off
}

{$GATEWAY_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8080 {
		transport http {
			keepalive 30s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format json
	}
}
