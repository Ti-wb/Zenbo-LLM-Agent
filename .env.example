# OpenAI-compatible API configuration
# API keys are intentionally blank. Never commit a populated .env file.
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4.1-mini
VITE_TTS_MODEL=gpt-4o-mini-tts
VITE_TTS_VOICE=alloy
VITE_SPEECH_MODEL=gpt-4o-mini-transcribe
VITE_IMAGE_MODEL=gpt-image-1

# Finnhub stock-data integration
VITE_FINNHUB_API_KEY=
VITE_FINNHUB_API_URL=https://finnhub.io/api

# Firecrawl web-search integration
# Configure either VITE_FIRECRAWL_API_KEY or the legacy TOKEN alias, not both.
VITE_FIRECRAWL_API_KEY=
VITE_FIRECRAWL_API_TOKEN=
VITE_FIRECRAWL_API_URL=https://api.firecrawl.dev
